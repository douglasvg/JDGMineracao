---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAFinal from '../components/home/CTAFinal.astro';
import { localidadesPontos } from '../data/localidadesPontos';
import { Phone, Clock, Car, ParkingSquare, ArrowUpRight } from 'lucide-react';

const pontos = localidadesPontos;

const tipoConfig = {
  deposito: {
    label: 'Depósito',
    badgeClass: 'bg-[#eeeef7] text-[#393e92]',
  },
  extracao: {
    label: 'Extração',
    badgeClass: 'bg-[#fef3e2] text-[#C9922A]',
  },
} as const;

---

<BaseLayout
  title="Localidades | JDG Mineração"
  description="Conheça os pontos de depósito e extração da JDG Mineração para retirada rápida e eficiente."
>
  <section class="bg-[#0D1B2A]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24 lg:px-8 lg:py-28">
      <div class="max-w-4xl">
        <span class="mb-6 inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white">
          Nossas Localidades
        </span>
        <h1 class="text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
          Onde Estamos
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
          Conheça nossos pontos de depósito e extração. Estrutura organizada para retirada rápida e
          eficiente.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div
      class="mx-auto flex max-w-7xl flex-wrap gap-3 px-4 sm:px-6 lg:px-8"
      role="tablist"
      aria-label="Filtrar por tipo de localidade"
      data-local-filter-tabs
    >
      <div class="hidden" aria-hidden="true">
        <!-- referência para o Tailwind incluir classes usadas no script -->
        <span
          class="inline-flex items-center rounded-full border border-[#393e92] bg-[#393e92] px-5 py-2 text-sm font-semibold text-white"
        ></span>
        <span
          class="inline-flex items-center rounded-full border border-[#C9922A] bg-[#C9922A] px-5 py-2 text-sm font-semibold text-white"
        ></span>
        <span
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-semibold text-slate-700"
        ></span>
      </div>
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-local-filter="todos"
        class="local-filter-btn inline-flex items-center rounded-full border border-[#393e92] bg-[#393e92] px-5 py-2 text-sm font-semibold text-white"
      >
        Todos
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-local-filter="deposito"
        class="local-filter-btn inline-flex items-center rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-semibold text-slate-700"
      >
        Depósito
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-local-filter="extracao"
        class="local-filter-btn inline-flex items-center rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-semibold text-slate-700"
      >
        Extração
      </button>
    </div>
  </section>

  <section class="bg-white pb-20 pt-4 sm:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <label for="localidades-search" class="mb-2 block text-sm font-semibold text-slate-700">
          Buscar unidade por nome ou cidade
        </label>
        <input
          id="localidades-search"
          type="search"
          placeholder="Ex.: São Mateus, União da Vitória..."
          autocomplete="off"
          data-local-search
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-[#393e92] focus:outline-none focus:ring-2 focus:ring-[#393e92]/20"
        />
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-find-nearest
            class="inline-flex items-center rounded-lg border border-[#393e92] bg-[#393e92] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#2f347d] disabled:cursor-not-allowed disabled:opacity-70"
          >
            Encontrar localização mais próxima
          </button>
          <p class="text-sm text-slate-600" data-nearest-status aria-live="polite"></p>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          Sua localização é usada só para ordenar as unidades por rota e não é armazenada pela JDG Mineração. É enviada ao
          nosso servidor e ao Google apenas para calcular a distância por estrada.
        </p>
      </div>

      <div class="mb-6 text-sm text-slate-600" data-local-results aria-live="polite"></div>

      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-localidades-list
      >
        {
          pontos.map((ponto, index) => {
            const cfg = tipoConfig[ponto.tipo];
            const iconWrap =
              ponto.tipo === 'deposito'
                ? 'bg-[#eeeef7] text-[#393e92]'
                : 'bg-[#fef3e2] text-[#C9922A]';
            const linkClass =
              ponto.tipo === 'deposito'
                ? 'border-[#393e92] text-[#393e92] hover:bg-[#393e92]'
                : 'border-[#C9922A] text-[#C9922A] hover:bg-[#C9922A]';
            const searchable = `${ponto.nome} ${ponto.cidade} ${'bairro' in ponto && ponto.bairro ? ponto.bairro : ''}`;

            return (
              <article
                class="flex min-w-0 flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg data-[map-expanded]:col-span-full data-[map-expanded]:md:flex-row data-[map-expanded]:md:items-stretch data-[map-expanded]:md:gap-6 data-[map-expanded]:md:p-6 sm:p-6"
                data-local-tipo={ponto.tipo}
                data-local-search-text={searchable.toLowerCase()}
                data-local-index={index}
                data-local-lat={ponto.lat}
                data-local-lng={ponto.lng}
              >
                <div class="flex min-w-0 flex-1 flex-col" data-local-card-main>
                  <span
                    class:list={[
                      'inline-flex w-fit rounded-full px-3 py-1.5 text-xs font-semibold sm:text-sm',
                      cfg.badgeClass,
                    ]}
                  >
                    {cfg.label}
                  </span>
                  <h2 class="mt-3 text-lg font-bold leading-snug text-slate-900 sm:text-xl">
                    {ponto.nome}
                  </h2>
                  <p class="mt-1 text-sm text-slate-600">{ponto.cidade}</p>
                  <p class="mt-1 hidden text-xs font-semibold text-[#393e92]" data-local-distance></p>

                  <div class="mt-4 space-y-1 border-t border-slate-200 pt-4 text-sm text-slate-600">
                    {'endereco' in ponto && ponto.endereco ? <p>{ponto.endereco}</p> : null}
                    {'bairro' in ponto && ponto.bairro ? <p>{ponto.bairro}</p> : null}
                    {'cep' in ponto && ponto.cep ? <p>{ponto.cep}</p> : null}
                  </div>

                  <div class="mt-4 flex flex-1 flex-col gap-3 text-sm text-slate-700">
                    <div class="flex items-start gap-2.5">
                      <div class:list={['mt-0.5 shrink-0 rounded-lg p-1.5', iconWrap]}>
                        <Phone className="h-3.5 w-3.5 sm:h-4 sm:w-4" />
                      </div>
                      <div class="min-w-0">
                        <p class="font-semibold text-slate-900">Telefone</p>
                        <p class="break-words">{ponto.telefone}</p>
                      </div>
                    </div>
                    <div class="flex items-start gap-2.5">
                      <div class:list={['mt-0.5 shrink-0 rounded-lg p-1.5', iconWrap]}>
                        <Clock className="h-3.5 w-3.5 sm:h-4 sm:w-4" />
                      </div>
                      <div class="min-w-0">
                        <p class="font-semibold text-slate-900">Horário</p>
                        <p>{ponto.horario}</p>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 flex flex-col gap-2">
                    <button
                      type="button"
                      data-map-toggle
                      class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
                      aria-expanded="false"
                    >
                      Mostrar mapa
                    </button>
                    <a
                      href={ponto.maps}
                      target="_blank"
                      rel="noreferrer"
                      class:list={[
                        'inline-flex w-full items-center justify-center rounded-lg border px-4 py-2.5 text-sm font-semibold transition-colors hover:text-white',
                        linkClass,
                      ]}
                    >
                      Ver no Mapa
                      <ArrowUpRight className="ml-2 h-4 w-4 shrink-0" />
                    </a>
                  </div>
                </div>

                <div
                  class="hidden min-h-[260px] w-full min-w-0 overflow-hidden rounded-xl border border-slate-200 shadow-sm md:min-h-[320px] md:flex-1 md:basis-0 md:self-stretch"
                  data-map-container
                >
                  <iframe
                    data-map-src={`https://www.google.com/maps?q=${ponto.lat},${ponto.lng}&z=${'zoom' in ponto && ponto.zoom != null ? ponto.zoom : 15}&output=embed`}
                    width="100%"
                    height="100%"
                    style="border:0; border-radius: 12px;"
                    class="block h-[280px] w-full md:h-[min(50vh,440px)] md:min-h-[320px]"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Mapa — ${ponto.nome}`}
                  />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="bg-[#f8f9fa] py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
          Como Chegar
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-4 inline-flex rounded-xl bg-[#eeeef7] p-3 text-[#393e92]">
            <Car className="h-6 w-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">De Carro</h3>
          <p class="mt-3 text-slate-600">
            No depósito de União da Vitória, acesso direto pela BR-153 (Bairro São Gabriel). Em São Mateus do
            Sul, o depósito fica na Rod. do Xisto (Fluviópolis) e a extração em outro ponto — use o mapa de
            cada unidade.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-4 inline-flex rounded-xl bg-[#fef3e2] p-3 text-[#C9922A]">
            <ParkingSquare className="h-6 w-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">Estacionamento</h3>
          <p class="mt-3 text-slate-600">
            Área para manobra de caminhões e veículos de grande porte disponível.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-4 inline-flex rounded-xl bg-slate-100 p-3 text-slate-700">
            <Clock className="h-6 w-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">Horário de Retirada</h3>
          <p class="mt-3 whitespace-pre-line text-slate-600">
            Varia por unidade (segunda a sexta):
            <br />
            <br />
            Escritório e Depósito (União da Vitória): 07:00 às 22:00.
            <br />
            Depósito (São Mateus do Sul — Fluviópolis): 07:00 às 22:00.
            <br />
            Extração (São Mateus do Sul): 09:00 às 17:00.
            <br />
            <br />
            Chegue com antecedência.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTAFinal />

  <script is:inline>
    (function () {
      const baseInactive =
        'local-filter-btn inline-flex items-center rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-semibold text-slate-700';
      const baseActiveBlue =
        'local-filter-btn inline-flex items-center rounded-full border border-[#393e92] bg-[#393e92] px-5 py-2 text-sm font-semibold text-white';
      const baseActiveGold =
        'local-filter-btn inline-flex items-center rounded-full border border-[#C9922A] bg-[#C9922A] px-5 py-2 text-sm font-semibold text-white';

      let currentFilter = 'todos';
      let currentSearch = '';

      function normalize(value) {
        return (value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/\p{Diacritic}/gu, '');
      }

      function updateListVisibility() {
        const rows = document.querySelectorAll('[data-local-tipo]');
        let visibleCount = 0;

        rows.forEach((row) => {
          const tipo = row.getAttribute('data-local-tipo');
          const text = row.getAttribute('data-local-search-text') || '';
          const matchesFilter = currentFilter === 'todos' || tipo === currentFilter;
          const matchesSearch = !currentSearch || normalize(text).includes(currentSearch);
          const show = matchesFilter && matchesSearch;
          if (show) visibleCount += 1;
          row.classList.toggle('hidden', !show);
        });

        const resultNode = document.querySelector('[data-local-results]');
        if (resultNode) {
          resultNode.textContent =
            visibleCount === 1
              ? '1 localidade encontrada'
              : `${visibleCount} localidades encontradas`;
        }
      }

      function setNearestStatus(message, tone) {
        const status = document.querySelector('[data-nearest-status]');
        if (!status) return;
        const colorClass =
          tone === 'error'
            ? 'text-red-600'
            : tone === 'success'
              ? 'text-emerald-700'
              : tone === 'warning'
                ? 'text-amber-700'
                : 'text-slate-600';
        status.className = `text-sm ${colorClass}`;
        status.textContent = message;
      }

      function resetToDefaultOrder() {
        const list = document.querySelector('[data-localidades-list]');
        if (!list) return;
        const cards = Array.from(list.querySelectorAll('[data-local-tipo]'));
        cards
          .sort((a, b) => Number(a.getAttribute('data-local-index')) - Number(b.getAttribute('data-local-index')))
          .forEach((card) => list.appendChild(card));
      }

      function updateDistanceBadges(distanceByIndex, labelMode) {
        const suffix =
          labelMode === 'straight' ? 'em linha reta' : 'por estrada';
        const cards = document.querySelectorAll('[data-local-tipo]');
        cards.forEach((card) => {
          const distanceNode = card.querySelector('[data-local-distance]');
          const index = card.getAttribute('data-local-index');
          if (!distanceNode || index == null) return;
          const distanceInMeters = distanceByIndex.get(Number(index));
          if (typeof distanceInMeters !== 'number' || !Number.isFinite(distanceInMeters)) {
            distanceNode.classList.add('hidden');
            distanceNode.textContent = '';
            return;
          }
          const km = distanceInMeters / 1000;
          const text =
            km < 1
              ? `${Math.round(distanceInMeters)} m ${suffix}`
              : `${km.toFixed(1)} km ${suffix}`;
          distanceNode.textContent = text;
          distanceNode.classList.remove('hidden');
        });
      }

      function haversineMeters(lat1, lng1, lat2, lng2) {
        const R = 6371000;
        const toRad = (d) => (d * Math.PI) / 180;
        const dLat = toRad(lat2 - lat1);
        const dLng = toRad(lng2 - lng1);
        const a =
          Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
      }

      function applyGoogleOrder(list, cards, rows) {
        const cardsByIndex = new Map(
          cards.map((card) => [Number(card.getAttribute('data-local-index')), card]),
        );
        rows.forEach((row) => {
          if (!row || typeof row.index !== 'number') return;
          const card = cardsByIndex.get(row.index);
          if (card) list.appendChild(card);
        });
        const distanceByIndex = new Map();
        rows.forEach((row) => {
          if (!row || typeof row.index !== 'number') return;
          const m = row.meters;
          distanceByIndex.set(
            row.index,
            typeof m === 'number' && Number.isFinite(m) ? m : null,
          );
        });
        updateDistanceBadges(distanceByIndex, 'road');
      }

      async function tryGoogleRoutes(userLat, userLng, list, cards) {
        const response = await fetch('/api/localidades-route-distances', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userLat, userLng }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !Array.isArray(payload.distances)) return false;
        let any = false;
        for (const row of payload.distances) {
          if (row && typeof row.meters === 'number' && Number.isFinite(row.meters)) {
            any = true;
            break;
          }
        }
        if (!any) return false;
        applyGoogleOrder(list, cards, payload.distances);
        return true;
      }

      async function tryOsrm(userLat, userLng, list, cards) {
        const destinations = cards.map((card) => {
          const lat = Number(card.getAttribute('data-local-lat'));
          const lng = Number(card.getAttribute('data-local-lng'));
          if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
            throw new Error('Coordenadas invalidas.');
          }
          return { card, lat, lng };
        });
        const coords = [`${userLng},${userLat}`, ...destinations.map((d) => `${d.lng},${d.lat}`)].join(
          ';',
        );
        const url = `https://router.project-osrm.org/table/v1/driving/${coords}?sources=0&annotations=distance`;
        const response = await fetch(url);
        if (!response.ok) return false;
        const payload = await response.json();
        if (
          payload.code !== 'Ok' ||
          !Array.isArray(payload.distances) ||
          !Array.isArray(payload.distances[0])
        ) {
          return false;
        }
        const sourceDistances = payload.distances[0];
        const ranked = destinations
          .map((dest, idx) => {
            const distance = sourceDistances[idx + 1];
            return {
              ...dest,
              distance:
                typeof distance === 'number' && Number.isFinite(distance)
                  ? distance
                  : Number.POSITIVE_INFINITY,
            };
          })
          .sort((a, b) => a.distance - b.distance);
        ranked.forEach(({ card }) => list.appendChild(card));
        const distanceByIndex = new Map(
          ranked.map((item) => [Number(item.card.getAttribute('data-local-index')), item.distance]),
        );
        updateDistanceBadges(distanceByIndex, 'road');
        return true;
      }

      function sortByHaversine(userLat, userLng, list, cards) {
        const items = cards.map((card) => {
          const lat = Number(card.getAttribute('data-local-lat'));
          const lng = Number(card.getAttribute('data-local-lng'));
          const idx = Number(card.getAttribute('data-local-index'));
          const d = haversineMeters(userLat, userLng, lat, lng);
          return { card, idx, d };
        });
        items.sort((a, b) => a.d - b.d);
        items.forEach(({ card }) => list.appendChild(card));
        const distanceByIndex = new Map(items.map((i) => [i.idx, i.d]));
        updateDistanceBadges(distanceByIndex, 'straight');
      }

      /**
       * @returns {'google'|'osrm'|'straight'}
       */
      async function sortByRoadDistanceWithFallback(userLat, userLng) {
        const list = document.querySelector('[data-localidades-list]');
        if (!list) throw new Error('Lista nao encontrada.');
        const cards = Array.from(list.querySelectorAll('[data-local-tipo]'));
        if (!cards.length) return 'straight';

        try {
          if (await tryGoogleRoutes(userLat, userLng, list, cards)) return 'google';
        } catch (_) {
          /* tentar proximo */
        }

        try {
          if (await tryOsrm(userLat, userLng, list, cards)) return 'osrm';
        } catch (_) {
          /* tentar proximo */
        }

        sortByHaversine(userLat, userLng, list, cards);
        return 'straight';
      }

      function applyFilter(filter) {
        currentFilter = filter;
        updateListVisibility();

        const buttons = document.querySelectorAll('[data-local-filter]');
        buttons.forEach((btn) => {
          const f = btn.getAttribute('data-local-filter');
          const isActive = f === filter;
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          if (f === 'extracao' && isActive) {
            btn.className = baseActiveGold;
          } else if (isActive) {
            btn.className = baseActiveBlue;
          } else {
            btn.className = baseInactive;
          }
        });
      }

      function init() {
        const tabs = document.querySelector('[data-local-filter-tabs]');
        if (!tabs) return;
        tabs.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-local-filter]');
          if (!btn || !(btn instanceof HTMLButtonElement)) return;
          const filter = btn.getAttribute('data-local-filter');
          if (filter) applyFilter(filter);
        });

        const searchInput = document.querySelector('[data-local-search]');
        if (searchInput && searchInput instanceof HTMLInputElement) {
          searchInput.addEventListener('input', () => {
            currentSearch = normalize(searchInput.value.trim());
            updateListVisibility();
          });
        }

        const cards = document.querySelectorAll('[data-local-tipo]');
        cards.forEach((card) => {
          const toggle = card.querySelector('[data-map-toggle]');
          const mapContainer = card.querySelector('[data-map-container]');
          const iframe = mapContainer ? mapContainer.querySelector('iframe') : null;
          if (!toggle || !mapContainer || !iframe || !(toggle instanceof HTMLButtonElement)) return;

          toggle.addEventListener('click', () => {
            const isHidden = mapContainer.classList.contains('hidden');
            if (isHidden) {
              const dataSrc = iframe.getAttribute('data-map-src');
              if (dataSrc && !iframe.getAttribute('src')) iframe.setAttribute('src', dataSrc);
              mapContainer.classList.remove('hidden');
              card.setAttribute('data-map-expanded', '');
              toggle.textContent = 'Ocultar mapa';
              toggle.setAttribute('aria-expanded', 'true');
            } else {
              mapContainer.classList.add('hidden');
              card.removeAttribute('data-map-expanded');
              toggle.textContent = 'Mostrar mapa';
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
        });

        const nearestButton = document.querySelector('[data-find-nearest]');
        if (nearestButton && nearestButton instanceof HTMLButtonElement) {
          nearestButton.addEventListener('click', () => {
            if (!navigator.geolocation) {
              resetToDefaultOrder();
              updateDistanceBadges(new Map());
              setNearestStatus(
                'Seu navegador nao suporta geolocalizacao. Exibindo a ordem padrao das unidades.',
                'error',
              );
              return;
            }

            nearestButton.disabled = true;
            setNearestStatus('Obtendo sua localizacao para calcular a melhor rota...', 'info');

            navigator.geolocation.getCurrentPosition(
              async (position) => {
                try {
                  const { latitude, longitude } = position.coords;
                  const mode = await sortByRoadDistanceWithFallback(latitude, longitude);
                  if (mode === 'google') {
                    setNearestStatus(
                      'Unidades ordenadas por distância por estrada (Google).',
                      'success',
                    );
                  } else if (mode === 'osrm') {
                    setNearestStatus(
                      'Unidades ordenadas por rota (serviço alternativo). O Google não respondeu no momento.',
                      'warning',
                    );
                  } else {
                    setNearestStatus(
                      'Ordenação por distância em linha reta. Não foi possível calcular a rota por estrada agora.',
                      'info',
                    );
                  }
                } catch (_) {
                  resetToDefaultOrder();
                  updateDistanceBadges(new Map());
                  setNearestStatus(
                    'Não foi possível ordenar as unidades agora. Tente de novo ou use o campo de busca acima.',
                    'error',
                  );
                } finally {
                  nearestButton.disabled = false;
                  updateListVisibility();
                }
              },
              (error) => {
                resetToDefaultOrder();
                updateDistanceBadges(new Map());
                const denied = error && error.code === 1;
                setNearestStatus(
                  denied
                    ? 'Permissão de localização negada. Ative no ícone de cadeado do navegador (permissões do site) ou use o buscador acima.'
                    : 'Não foi possível obter sua localização. Verifique se o GPS está ativo ou use o buscador acima.',
                  'error',
                );
                nearestButton.disabled = false;
                updateListVisibility();
              },
              {
                enableHighAccuracy: true,
                timeout: 12000,
                maximumAge: 60000,
              },
            );
          });
        }

        applyFilter('todos');
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
