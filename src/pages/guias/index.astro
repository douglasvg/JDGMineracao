---
import { BookOpen } from 'lucide-react';
import BaseLayout from '@layouts/BaseLayout.astro';
import { guias } from '@data/guias';

const pageTitle = 'Guias técnicos | JDG Mineração';
const pageDescription =
  'Guias práticos sobre areia e uso em obra: granulometria, especificação e boas práticas para construtoras e empreiteiras.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="bg-[#0D1B2A] px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="container mx-auto max-w-4xl text-center">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[#C9922A]"
      >
        <BookOpen className="w-3.5 h-3.5" aria-hidden="true" />
        Guias técnicos
      </p>
      <h1
        class="text-3xl font-bold leading-tight text-white sm:text-4xl md:text-5xl"
        style="font-family: 'Barlow Condensed', sans-serif;"
      >
        Guias para especificação e uso em obra
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
        Conteúdo objetivo para engenharia, compras e canteiro — com foco em aplicação prática e
        decisão técnica.
      </p>
    </div>
  </section>

  <section class="bg-[#f8f9fa] px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {guias.map((guia) => (
          <a
            href={`/guias/${guia.slug}`}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#393e92]/25 hover:shadow-lg"
          >
            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="inline-flex rounded-full bg-[#393e92]/10 px-3 py-1 text-xs font-semibold text-[#393e92]">
                Guia
              </span>
              {guia.readTimeLabel && (
                <span class="text-xs text-slate-500">{guia.readTimeLabel}</span>
              )}
            </div>
            <h2
              class="text-xl font-bold text-slate-900 group-hover:text-[#393e92] transition-colors"
              style="font-family: 'Barlow Condensed', sans-serif;"
            >
              {guia.title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{guia.description}</p>
            <span class="mt-6 inline-flex items-center text-sm font-semibold text-[#393e92]">
              Ler guia
              <span class="ml-1 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
